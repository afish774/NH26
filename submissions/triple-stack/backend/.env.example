# NexDesk Backend Environment Template

# -----------------------------------
# Core App
# -----------------------------------
SECRET_KEY=change_this_in_prod
ALGORITHM=HS256
LOG_LEVEL=INFO
STRICT_STARTUP=false
ENABLE_PERFORMANCE_MONITORING=true

# -----------------------------------
# Database (PostgreSQL only)
# -----------------------------------
DATABASE_URL=postgresql://nexdesk:nexdesk_secret@localhost:5432/nexdesk
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# -----------------------------------
# Redis
# -----------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------
# AI Keys
# -----------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=

# -----------------------------------
# AWS (optional)
# -----------------------------------
USE_AWS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_TRANSCRIBE_BUCKET=

# -----------------------------------
# RAG / Vector DB (ChromaDB)
# -----------------------------------
CHROMA_PERSISTENT=true
CHROMA_PERSIST_DIR=chroma_data
USE_ADVANCED_RAG=true
HYDE_ENABLED=true
CROSS_ENCODER_ENABLED=true
USE_ADVANCED_RETRIEVAL=true
HYBRID_ALPHA=0.7
DEFLECT_THRESHOLD=0.72

# -----------------------------------
# Email Integration
# -----------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
EMAIL_FROM_ADDRESS=support@nexdesk.com
EMAIL_FROM_NAME=NexDesk Support
EMAIL_AUTO_REPLY=true
PORTAL_URL=https://support.nexdesk.com

# -----------------------------------
# Slack / Teams Integration
# -----------------------------------
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
SLACK_DEFAULT_CHANNEL=
TEAMS_WEBHOOK_URL=

# -----------------------------------
# Frontend
# -----------------------------------
FRONTEND_URL=http://localhost:3000

# -----------------------------------
# Network Monitoring
# -----------------------------------
ENABLE_NETWORK_MONITORING=true
